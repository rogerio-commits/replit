# =============================================================================
# Ulimax — Sistema de Controle de Projetos
# =============================================================================
# Copie para .env no desenvolvimento local. Em produção, cadastre estes valores
# em Settings → Environment Variables no painel da Vercel.
#
# NUNCA versione o arquivo .env preenchido. Ele está no .gitignore.

# --- Banco de dados ----------------------------------------------------------
# Supabase → Project Settings → Database → Connection string.
# Em serverless use SEMPRE a string do POOLER (porta 6543), não a direta (5432):
# cada invocação abre uma conexão, e o Postgres esgota rápido sem o pooler.
DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres

# --- Autenticação (Clerk) ----------------------------------------------------
# Clerk → API Keys. Atenção: as chaves usadas hoje foram emitidas pelo painel de
# Auth do Replit. Fora dele é preciso uma conta própria na Clerk e chaves novas.
CLERK_PUBLISHABLE_KEY=pk_...
CLERK_SECRET_KEY=sk_...

# Mesmas chaves expostas ao frontend (o prefixo VITE_ é obrigatório).
VITE_CLERK_PUBLISHABLE_KEY=pk_...
# Opcional: proxy do Frontend API pelo próprio domínio, evitando configurar DNS.
VITE_CLERK_PROXY_URL=https://<seu-dominio>/api/__clerk

# --- Armazenamento de arquivos (Supabase Storage) ----------------------------
# Supabase → Project Settings → API.
# A service_role key ignora RLS: mantenha apenas no servidor, nunca no frontend.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role_key>
SUPABASE_STORAGE_BUCKET=ulimax

# --- E-mail (Resend) ---------------------------------------------------------
# Opcional. Sem a chave, a cobrança automática roda mas não envia e-mails.
RESEND_API_KEY=re_...
EMAIL_FROM="Ulimax <projetos@seu-dominio.com.br>"

# --- Assistente de IA --------------------------------------------------------
# Opcional. Sem a chave, a funcionalidade fica indisponível e o resto segue.
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=sk-...

# --- Agendamento -------------------------------------------------------------
# Segredo que protege GET /api/cron/daily-reminders. Na Vercel, basta cadastrar
# a variável: a plataforma envia o header Authorization automaticamente.
# Gere um valor aleatório longo (ex.: openssl rand -hex 32).
CRON_SECRET=<valor-aleatorio-longo>

# --- Aplicação ---------------------------------------------------------------
APP_URL=https://<seu-dominio>
NODE_ENV=production
LOG_LEVEL=info

# Usado apenas quando o servidor roda como processo próprio (dev local).
PORT=8080
